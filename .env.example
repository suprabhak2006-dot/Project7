# ============================================================
# DEEPTRACE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Environment Mode: development | production | test
ENVIRONMENT=development

# Core API Security
SECRET_KEY=replace-with-a-secure-random-64-character-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Development:
DATABASE_URL=sqlite+aiosqlite:///./storage/deeptrace.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/deeptrace

# Redis & Celery Worker Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Paths
STORAGE_PATH=./storage
MODEL_PATH=./models
REPORT_PATH=./reports

# Upload Constraints
MAX_UPLOAD_SIZE_MB=500

# Hardware Acceleration
ENABLE_GPU=false
